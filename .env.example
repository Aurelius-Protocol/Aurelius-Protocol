# Subnet 37. The config verification key ships with the miner; confirm current chain pins.
AURELIUS_ENV=mainnet
NETUID=37
AURELIUS_CHAIN=mainnet
SUBSTRATE_URL=wss://archive.chain.opentensor.ai:443
CHAIN_ID=bittensor-mainnet:2f0555cc76fc2840a25a6ea3b9637146806f1f44b090c175ffde2a7e5ab36c03
AURELIUS_AXON_EXPECTED_CHAIN_NAME=Bittensor
AURELIUS_AXON_EXPECTED_GENESIS_HASH=0x2f0555cc76fc2840a25a6ea3b9637146806f1f44b090c175ffde2a7e5ab36c03
AURELIUS_RUNTIME_SPEC_PIN=478
AURELIUS_RUNTIME_TRANSACTION_VERSION_PIN=1
CENTRAL_API_URL=https://central.aureliusaligned.ai
# CONFIG_SIGNING_PUBKEY is optional; omit it to use the bundled subnet 37 public key.
AURELIUS_TRANSPORT=btauth
AURELIUS_IDENTITY_SOURCE=bittensor
AURELIUS_CLOCK=real
AURELIUS_CANDIDATE_SOURCE=staging
AURELIUS_REQUIRE_HOTKEY_ONLY_WALLET=true
AURELIUS_BT_WALLET=miner
AURELIUS_BT_HOTKEY=default
AURELIUS_BT_WALLET_PATH=REPLACE_WITH_ABSOLUTE_PATH_TO_MINER_WALLETS
MINER_HOTKEY=default
AURELIUS_AXON_EXTERNAL_IP=REPLACE_WITH_YOUR_PUBLIC_IPV4
AURELIUS_AXON_EXTERNAL_PORT=8091
AURELIUS_AXON_ENDPOINT_PROFILE=public
AURELIUS_AXON_PUBLISH_STATE_DIR=REPLACE_WITH_ABSOLUTE_PATH_TO_STATE/axon
AURELIUS_BITTENSOR_NONCE_DB=REPLACE_WITH_ABSOLUTE_PATH_TO_STATE/nonces.sqlite3
AURELIUS_MINER_DATA=REPLACE_WITH_ABSOLUTE_PATH_TO_STATE/pool
AURELIUS_MINER_JOURNAL=REPLACE_WITH_ABSOLUTE_PATH_TO_STATE/attempts.sqlite3
# Uncomment only after reading INCENTIVES.md, for runs without a terminal (systemd, Docker).
# AURELIUS_ACCEPT_INCENTIVES=yes
# Local readiness only. Keep this port private; production queries use btauth on 8091.
AURELIUS_MINER_HTTP_PORT=8092
